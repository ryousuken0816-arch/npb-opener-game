[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/title/title.gd" id="1_title"]
[ext_resource type="Script" path="res://scripts/team_background.gd" id="2_bg"]

[node name="Title" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_title")

[node name="Background" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_bg")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="Center/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "NPBオーペナゲーム"
horizontal_alignment = 1

[node name="SubLabel" type="Label" parent="Center/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "担当する球団を選んでください"
horizontal_alignment = 1

[node name="Leagues" type="HBoxContainer" parent="Center/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 48
alignment = 1
